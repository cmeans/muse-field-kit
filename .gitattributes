# LF everywhere it matters: a CRLF checkout breaks consume.py's sh launcher
# (#!/bin/sh\r) and puts \r on the last argument, and the test vectors are
# compared byte for byte.
*.sh   text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.pem  text eol=lf
# *.ps1 stays LF too (builder's choice, Task 5w): Windows PowerShell 5.1 and
# PowerShell 7 both parse LF scripts, and test/run-test.ps1 checks that
# handoff.ps1 and itself are ASCII only, have no CR and parse, on the Windows
# runner as everywhere (the CI CR check does not list *.ps1; it could).
*.ps1  text eol=lf
